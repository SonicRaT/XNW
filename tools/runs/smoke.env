# The smoke gate's own profile (xnw smoke forces XNW_GPU=null, the software adapter, headless).
# The switches that matter for boot; no key presses are needed for 20 s.
XNW_PATCH='watchdog,upscaler,cbalign,renderscale,place_budget'
XNW_ROLES='lock'
XNW_SHARED='2'
XNW_PACING='free'
XNW_TRACE='perf'
XNW_FRAME_STATS='1'
XNW_GPU_CRUMBS='0'
# the null counter lines start at frame 30
#expect 15 frameskip: \d+ frames rendered, \d+ skipped
#fixture tools/fixtures/boot-null.log
